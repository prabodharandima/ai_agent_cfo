{
  "Application": {
    "Name": "CFO AI Agent",
    "DemoMode": true
  },
  "AI": {
    "Provider": "Ollama",
    "Ollama": {
      "Model": "llama3.2:3b",
      "BaseUrl": "http://localhost:11434",
      "TimeoutSeconds": 120,
      "Temperature": 0,
      "ContextLength": 4096,
      "MaxOutputTokens": 512
    }
  },
  "AgentMiddleware": {
    "PromptInjectionCheckEnabled": true,
    "SuspiciousPromptPhrases": [
      "ignore previous instructions",
      "ignore all previous instructions",
      "disregard previous instructions",
      "reveal the system prompt",
      "show the system prompt"
    ]
  },
  "AgentSessions": {
    "MessageLimit": 8,
    "ExpirationMinutes": 30,
    "MaximumSessions": 1000
  },
  "Cache": {
    "Enabled": true,
    "UseDistributedCache": false,
    "Finance": {
      "SalesSummaryTtlSeconds": 60,
      "CurrentWeekSummaryTtlSeconds": 60,
      "WeekOverWeekComparisonTtlSeconds": 60,
      "CurrentMonthTopProductsTtlSeconds": 300,
      "HistoricalYearlyTotalsTtlSeconds": 3600,
      "BudgetTargetTtlSeconds": 300
    },
    "Rag": {
      "RetrievalTtlSeconds": 300
    }
  },
  "Chroma": {
    "BaseUrl": "http://localhost:8000",
    "CollectionName": "cfo-financial-knowledge",
    "Tenant": "default_tenant",
    "Database": "default_database",
    "TimeoutSeconds": 10
  },
  "Rag": {
    "KnowledgeFilesRoot": "../../data/knowledge",
    "MaxChunkCharacters": 1200,
    "ChunkOverlapPercentage": 15,
    "MaxKnowledgeContextCharacters": 4000,
    "MaximumRetrievalDistance": 1.25,
    "IndexVersion": "v1"
  },
  "Mcp": {
    "Finance": {
      "Enabled": true,
      "BaseUrl": "http://localhost:5081",
      "TimeoutSeconds": 10,
      "AllowedToolNames": [
        "get_sales_summary",
        "compare_sales_periods",
        "get_top_products",
        "get_historical_sales",
        "get_budget_target"
      ]
    },
    "KnowledgeFiles": {
      "Enabled": false,
      "BaseUrl": "http://localhost:5082",
      "RootPath": "data/knowledge",
      "UseLocalFallback": false,
      "TimeoutSeconds": 10,
      "AllowedToolNames": [
        "list_knowledge_files",
        "read_knowledge_file"
      ]
    }
  },
  "Frontend": {
    "AllowedOrigin": "http://localhost:5173"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
